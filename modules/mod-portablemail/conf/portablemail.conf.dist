###################################################################################################
#  mod-portablemail
#
#  Restores the world objects that CoA's portable gadgets summon - the Gnomish Portable Post
#  Tube is a mailbox, the transpolyporters are spellcasters, the Mystic Enchanting Altar is a
#  binder. The objects themselves are inserted by data/sql/db-world/portablemail.sql, which the
#  DB updater applies at startup; that file also carries the Fel Gateway's spell override, which
#  sets its lifetime to the 30 seconds the gadget's own text promises. This config file only
#  controls the module's own checks.
#
#  This code is part of the AzerothCore project. See AUTHORS file for Copyright information.
###################################################################################################

#    PortableMail.VerifyOnStartup
#        Description: Check once at startup that every object a portable gadget summons is
#                     present in `gameobject_template` with the type, model and size the realm
#                     shipped, and that the gadget's spell lives as long as the gadget says it
#                     does; log an error naming the row when either drifts.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
PortableMail.VerifyOnStartup = 1

#    PortableMail.Command
#        Description: Enable the `.portablemail status` game master command, which reports the
#                     same list on demand.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
PortableMail.Command = 1
